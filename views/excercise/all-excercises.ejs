<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/style.css">
    <title>all-excercises</title>
</head>

<body>
    <div id="content-container">
        <div class="nav-container">

            <%- include('../partials/navbar') %>
        </div>
        <div class="main-container">
            <form method="get" action="/excer/new"><button class="create-new-item">Create New Excercise</button></form>
            <h1>All-excercises</h1>
            <table>
                <tr>
                    <th>Excercise Name</th>
                    <th>guidingGIF</th>
                    <th>instructions</th>
                    <th>category</th>
                    <th>Edit/Delete</th>
                </tr>
                <% for(let e of excercises){ %>
                    <tr>
                        <td>
                            <%= e.excerciseName %>
                        </td>
                        <td><img src="<%= e.guidingGIF %>" alt="<%= e.excerciseName %>_guiding_gif"></td>
                        <td>
                            <%= e.instructions %>
                        </td>
                        <td>
                            <%= e.category.name %>
                        </td>
                        <td>
                            <form action="/excer/edit/<%= e.id %>" method="get"><button>Edit</button></form>
                            <form action="/excer/delete/<%= e.id %>?_method=DELETE" method="post">
                                <button class="delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% } %>

            </table>
        </div>

    </div>

</body>

</html>