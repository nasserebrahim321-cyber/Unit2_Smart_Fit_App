<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit-excercise</title>
</head>

<body>
    <h1>edit-excercise</h1>
    <form action="/excer/edit/<%= excercise.id %>?_method=PUT" method="post">
        <label for="excerciseName">Excercise Name :</label>
        <input type="text" name="excerciseName" id="excerciseName" required value="<%= excercise.excerciseName %>"><br>

        <label for="guidingGIF">Please add the url of guiding GIF for the excersice here : </label>
        <input type="url" name="guidingGIF" id="guidingGIF" value="<%= excercise.guidingGIF %>"><br>

        <label for="instructions">Instructions :</label>
        <input type="text" name="instructions" id="instructions" value="<%= excercise.instructions %>"><br>

        <label for="category">Excercise Category :</label>
        <select name="category" id="category">
            <!-- Hidden placeholder that can't be reselected -->
            <option value="" disabled selected hidden>Select an category</option>
            <% for(let c of categories) {%>
                <option value="<%= c.id %>" <%=excercise.category.toString()===c.id ? 'selected' : '' %>>
                    <%= c.name %>
                </option>
                <% } %>
        </select><br>

        <button>Edit Excersice</button>
    </form>

</body>

</html>